rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Test document for connection probe
    match /test/{docId} {
      allow read, write: if true;
    }

    // Master products and inventory
    match /products/{productId} {
      allow read, write: if true;
    }

    // Cashier transactions
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // Operational expenses
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // Customer debts and kas bon
    match /debts/{debtId} {
      allow read, write: if true;
    }

    // PS Rentals
    match /ps_rentals/{rentalId} {
      allow read, write: if true;
    }

    // PS Saved Time (Tabungan Sisa Waktu Pelanggan)
    match /ps_saved_times/{savedTimeId} {
      allow read, write: if true;
    }

    // Store profile and receipt settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
